# Nexus RMM Relay Server Configuration
# Copy to config.yaml and modify values

server:
  host: "0.0.0.0"
  port: 8443
  websocket_path: "/ws"
  read_timeout: "30s"
  write_timeout: "30s"
  idle_timeout: "120s"
  max_frame_size: 16777216  # 16MB

tls:
  cert_file: "C:/NexusRMM/certs/server.crt"
  key_file: "C:/NexusRMM/certs/server.key"
  ca_file: "C:/NexusRMM/certs/ca.crt"
  client_auth: "require_and_verify"

database:
  host: "localhost"
  port: 5432
  name: "nexusrmm"
  user: "nexusrmm"
  password: "CHANGE_ME"  # Set secure password
  max_conns: 20
  sslmode: "disable"

redis:
  host: "localhost"
  port: 6379
  password: ""  # Set if Redis has auth
  db: 0
  pool_size: 10

agent:
  heartbeat_interval: "30s"
  max_missed_heartbeats: 3
  enrollment_token_ttl: "24h"
  max_token_uses: 100

logging:
  level: "info"
  format: "json"
  output: "C:/NexusRMM/logs/relay.log"
